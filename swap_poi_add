#include<stdio.h>
void swap(int *, int *);
int main()
{
   int a,b;
   printf("Enter A Number : ");
   scanf("%d", &a);
   printf("Enter B Number : ");
   scanf("%d",&b);
   swap(&a,&b);
   printf("After Inter-Changing A  = %d ||  B  = %d\n",a,b);
   return 0;
}
void swap(int *a,int *b)
{
   *a = *a + *b;
   *b = *a - *b;
   *a = *a - *b;
}
