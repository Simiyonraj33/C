#include<stdio.h>

int main()
{
   int mat[10][10],i,j,cols,rows;

   printf("Enter No.Of Rows : ");
   scanf("%d", &rows);

   printf("Enter No.Of Coloumns : ");
   scanf("%d", &cols);

   printf("Enter Values Of the Matrix :\n");
   for(i=0;i<rows;i++)
   {
      for(j=0;j<cols;j++)
      {
         scanf("%d", *(mat+i)+j);
      }
   }


   printf("======Rows======\n");
   for(i=0;i<rows;i++)
   {
      int rowSum = 0;
      for(j=0;j<cols;j++)
      {
         rowSum += *(*(mat+i)+j);
      }
      printf("Sum Of Row %d : %d\n",i+1, rowSum);
   }
   printf("================\n");


   printf("=====Columns====\n");
   for(j=0;j<cols;j++)
   {
      int colSum = 0;
      for(i=0;i<rows;i++)
      {
         colSum += *(*(mat+i)+j);
      }
      printf("Sum Coloumn %d = %d\n",j+1,colSum);
   }
   printf("================\n");


   return 0;
}
